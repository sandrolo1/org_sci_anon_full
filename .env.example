# Copy this file to .env and fill in only what you need. Nothing here is required for the offline reviewer artifact,
# `pytest` or `research0 demo`. The DATABASE_URL/S3_*/AWS_* values below are local-only credentials of the Docker containers.
# Add your own OPENAI_API_KEY and UNPAYWALL_EMAIL to use the commands that call a model or look up PDFs.

DATABASE_URL=postgresql://research:local_only@localhost:55432/research
S3_ENDPOINT_URL=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=research-originals
AWS_ACCESS_KEY_ID=local_only
AWS_SECRET_ACCESS_KEY=local_only
OPENAI_API_KEY=
# Unpaywall asks for a real contact address on every request (open-access PDF lookup by DOI).
UNPAYWALL_EMAIL=
# Optional. OpenAlex is the second source of open-access PDFs, also tried when Unpaywall fails.
# A free key (openalex.org/settings/api) raises the API budget. Keyless use is rate limited.
OPENALEX_API_KEY=
# Optional. Semantic Scholar (its openAccessPdf) is the third source, asked only when Unpaywall and OpenAlex gave no file, and only
# when this key is set. The key allows 1 request per second across all endpoints: the downloader sends one every 1.1 s per process,
# so do not run two downloads (dashboard + CLI) at the same time with the same key.
SEMANTIC_SCHOLAR_API_KEY=

# Embeddings (Phases 2, 5, 6, 8). Default hash-rp-v1 is offline and lexical. openai:<model> sends text to OpenAI and costs money.
# EMBEDDING_MODEL=hash-rp-v1
# Read-only connection for discovery agents (role research_agent; set its password first: ALTER ROLE research_agent LOGIN PASSWORD '...')
# AGENT_DATABASE_URL=postgresql://research_agent:...@localhost:55432/research
# Discovery forum (research0 forum-serve, a service of its own). FORUM_BIND, FORUM_ALLOWED_HOSTS and FORUM_READ_ONLY work like their DASHBOARD_* counterparts. FORUM_BATCH_WORKERS (default 1, at most 4) is how many episodes of a batch run at the same time.
# Let the forum's agents run Python (episode setting "Analysis tools"). The code runs as the user of this server, in a subprocess with a time limit, a memory limit and a
# scrubbed environment: a safeguard against mistakes, NOT a security boundary. Leave unset on a shared or public machine; deploy/ never sets it.
# FORUM_ALLOW_LOCAL_CODE=1
# Dashboard behind a reverse proxy (set by deploy/compose.prod.yaml; leave unset locally)
# DASHBOARD_BIND=0.0.0.0
# DASHBOARD_ALLOWED_HOSTS=reviewers.example.org
# DASHBOARD_READ_ONLY=1

# Migration target (leave empty until migrating). Example for AWS:
# TARGET_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/research?sslmode=require
# TARGET_S3_BUCKET=your-globally-unique-bucket
# TARGET_S3_REGION=eu-north-1
# TARGET_AWS_PROFILE=default
# For S3-compatible targets only: TARGET_S3_ENDPOINT_URL, TARGET_AWS_ACCESS_KEY_ID, TARGET_AWS_SECRET_ACCESS_KEY
